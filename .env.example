SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
UNLXCK_ADMIN_EMAILS=ops@example.com
APP_CORS_ORIGINS=https://your-production-frontend-domain,https://your-admin-frontend-domain
# Production CORS should use exact origins. APP_CORS_ORIGIN_REGEX is disabled
# in production unless APP_ALLOW_PRODUCTION_CORS_REGEX=1 is explicitly set.
APP_CORS_ORIGIN_REGEX=
APP_ALLOW_PRODUCTION_CORS_REGEX=0
APP_ENV=production
UNLXCK_ENV=production
APP_PLAN_GENERATE_DAILY_LIMIT_PER_USER=5
APP_GENERATION_MAX_CONCURRENT_JOBS=1
APP_STAGE1_PLANNER_TIMEOUT_SECONDS=600
STAGE1_PLANNER_TIMEOUT_SECONDS=600
# Whole Stage 2 finalize budget: must exceed UNLXCK_STAGE2_TIMEOUT_SECONDS +
# 2x UNLXCK_STAGE2_STRUCTURED_TIMEOUT_SECONDS or card generation is cancelled early.
APP_STAGE2_FINALIZE_TIMEOUT_SECONDS=1500
UNLXCK_ENABLE_IN_PROCESS_GENERATION=0
UNLXCK_GENERATION_WORKER_STALE_AFTER_SECONDS=300
UNLXCK_GENERATION_WORKER_MAX_CONCURRENT_JOBS=1
APP_DAILY_GENERATION_CAP_EXEMPT_EMAILS=
APP_GENERATION_JOB_STALE_AFTER_SECONDS=300
OPENAI_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=true
ENABLE_SENTRY_DEBUG_ROUTE=false
# Web Push notifications (server-only VAPID credentials). Generate one matching
# key pair and keep the private key only in the backend production environment.
# Never expose it through NEXT_PUBLIC_* variables or commit a real value.
UNLXCK_VAPID_PRIVATE_KEY=
UNLXCK_VAPID_PUBLIC_KEY=
UNLXCK_VAPID_SUBJECT=mailto:ops@example.com
# Canonical installed-PWA origin used for notification deep links.
UNLXCK_PUSH_SITE_URL=https://your-production-frontend-domain
UNLXCK_MORNING_PUSH_ENABLED=1
UNLXCK_MORNING_PUSH_LOCAL_HOUR=7
UNLXCK_MORNING_PUSH_CUTOFF_LOCAL_HOUR=11
UNLXCK_MORNING_PUSH_SWEEP_INTERVAL_SECONDS=600
# Fight-camp orchestration rollout: send, observe (evaluate + legacy send), or legacy.
UNLXCK_FIGHT_CAMP_NOTIFICATIONS_MODE=observe
# Low-confidence final fallback only; athlete or schedule data always wins.
UNLXCK_NOTIFICATION_FALLBACK_TRAINING_TIME=18:00
# Secure beta feedback (server-only). Set a rate limit to 0 to disable it.
FEEDBACK_REPORT_LIMIT_PER_HOUR=5
FEEDBACK_SCREENSHOT_LIMIT_PER_HOUR=2
FEEDBACK_SCREENSHOT_RETENTION_DAYS=90
# Feedback is always stored for authenticated admins. These server-only values
# additionally attempt one privacy-minimised notification through Resend.
FEEDBACK_NOTIFICATION_EMAIL=unlxckedmind@gmail.com
FEEDBACK_FROM_EMAIL=Unlxck Feedback <feedback@your-verified-domain.com>
FEEDBACK_ADMIN_URL=https://your-production-frontend-domain/admin
RESEND_API_KEY=
# Structured-plan card generation (second Stage 2 conversion call). On by
# default; set to 0/false/no/off to disable and fall back to raw plan_text.
UNLXCK_STAGE2_STRUCTURED_PLAN=1
UNLXCK_STAGE2_MODEL=gpt-5-mini
UNLXCK_STAGE2_TIMEOUT_SECONDS=210
# Wider per-call budget for the structured-card calls (first pass + repair).
UNLXCK_STAGE2_STRUCTURED_TIMEOUT_SECONDS=600
# Structured-card calls request JSON output mode so the provider always returns
# valid JSON. On by default; set to 0/false/no/off if the model/endpoint rejects
# the text.format parameter (the markdown plan-text pass never uses the text.format parameter).
UNLXCK_STAGE2_STRUCTURED_JSON_MODE=1
# Opt-in: send the strict json_schema (built from StructuredTrainingPlan) so the
# provider guarantees the response conforms to the schema, not just valid JSON -
# which lets you retire the repair retry (UNLXCK_STAGE2_STRUCTURED_REPAIR=0).
# OFF by default: the schema is only structurally verified in-repo; confirm the
# live endpoint accepts it and outputs round-trip through validation in staging
# before enabling. Falls back to json_object mode if left off.
UNLXCK_STAGE2_STRUCTURED_SCHEMA_MODE=0
# Shared with the model's reasoning tokens; too low truncates the plan and fails the job. 0 = no cap.
UNLXCK_STAGE2_MAX_OUTPUT_TOKENS=0
UNLXCK_STAGE2_MAX_FIRST_PASS_CHARS=180000
UNLXCK_STAGE2_OPENAI_MAX_RETRIES=0
UNLXCK_STAGE2_INPUT_COST_PER_1M=0
UNLXCK_STAGE2_OUTPUT_COST_PER_1M=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy
# Where data-rights requests (access, deletion, consent questions) are sent.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=support@unlxck.com
