{
    servers {
        0rtt off
        max_header_size 32KB
        timeouts {
            read_header 10s
            idle 2m
        }
    }
}

{$API_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        Cache-Control "no-store"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @documentation path /docs /docs/* /redoc /redoc/*
    header @documentation Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src https://fastapi.tiangolo.com data:; font-src https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'"

    @api {
        not path /docs /docs/* /redoc /redoc/*
    }
    header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

    reverse_proxy api:8000 {
        transport http {
            dial_timeout 10s
            response_header_timeout 180s
        }
    }

    log {
        output stdout
        format json
    }
}
