        {
          "drill_id": "chest_strain_recovery_support",
          "bank_hash": "732d72eea53f2191531e19edf71b3e8893982803f508bce6afd1462d85441338",
          "stage": "calm",
          "instructions": "Protect the strained area and avoid movements that aggravate it. During the first 2 to 3 days, rest from exercise that loads it. Use comfortable everyday movement; do not force a stretch or add resisted chest work.",
          "dose": null,
          "camp_doses": {},
          "readiness_doses": {},
          "allowed_severities": [
            "low",
            "moderate"
          ],
          "stop_when": [
            "Stop if pain prevents comfortable movement or symptoms worsen.",
            "Seek help for severe or worsening pain, swelling or inability to use the area."
          ],
          "frequency": "daily",
          "minimum_gap_days": 1,
          "priority": 0,
          "sources": [
            "https://www.nhs.uk/conditions/sprains-and-strains/"
          ]
        },
        {
          "drill_id": "chest_strain_comfortable_movement",
          "bank_hash": "86969b567e9daf022d873d0c9df06983493f3d017edf0c0e86e0b6bd07cae150",
          "stage": "restore",
          "instructions": "When pain no longer stops movement, gently move your shoulder and arm through a comfortable range. Go at your own pace and stop before pain prevents movement. Avoid forced chest stretches, resisted chest flies and surgical-repair routines.",
          "dose": null,
          "camp_doses": {},
          "readiness_doses": {},
          "allowed_severities": [
