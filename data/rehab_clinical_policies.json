            "https://www.whittington.nhs.uk/mini-apps/leaflet/Default.asp?id=53&print=1"
          ]
        },
        {
          "drill_id": "ankle_sprain_supported_balance",
          "bank_hash": "f00f718eb8220c4f7ff0539627368fe22f7218b81b8ee82d3fad9d567276eae3",
          "stage": "restore",
          "instructions": "When standing and weight bearing are comfortable, practise balancing on the affected leg on firm ground, close to a stable counter for support. Start with a short comfortable attempt and build gradually. Keep support available; do not use a cushion or close your eyes.",
          "dose": null,
          "camp_doses": {},
          "readiness_doses": {},
          "allowed_severities": [
            "low",
            "moderate"
          ],
          "stop_when": [
            "Stop if pain prevents comfortable movement or symptoms worsen.",
            "Seek help for severe or worsening pain, swelling or inability to use the area."
          ],
          "frequency": "daily",
          "minimum_gap_days": 1,
          "priority": 5,
          "sources": [
            "https://www.whittington.nhs.uk/mini-apps/leaflet/Default.asp?id=53&print=1"
          ]
        },
        {
          "drill_id": "ankle_sprain_heel_lowering",
          "bank_hash": "c932d4b2b5a7bbfe4fbc77249ed2056cea2416add6982a3a5c84bc38cb5445ea",
          "stage": "restore",
          "instructions": "When weight bearing and gentle calf movement are comfortable, use a stable support and practise controlled heel lowering as shown in the linked ankle rehabilitation guidance. Work at your own pace, up to 2 sets on alternate days. The source gives no repetition target; stop before symptoms worsen.",
          "dose": null,
